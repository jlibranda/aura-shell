+/// Assignment — the authoritative, effective-dated placement of a person into
+/// the organization (ADR-012 §5, §7). This is the source of truth for a
+/// person's org unit and primary manager over time; the Employee.department/
+/// team/manager/workLocation columns are legacy. A placement is never edited
+/// in place: a transfer ends the current window and opens a new one, so
+/// historical placement is always resolvable. Composite tenant-scoped foreign
+/// keys make a cross-tenant person/manager/org-unit reference impossible at the
+/// database. "At most one PRIMARY in force per person at any instant" is
+/// enforced by a GIST exclusion constraint installed in the migration.
+model Assignment {
+  id             String    @id @default(uuid()) @map("assignment_id")
+  tenantId       String    @map("tenant_id")
+  personId       String    @map("person_id")
+  orgUnitId      String    @map("org_unit_id")
+  managerId      String?   @map("manager_id")
+  isPrimary      Boolean   @default(true) @map("is_primary")
+  effectiveFrom  DateTime  @map("effective_from") @db.Timestamptz(6)
+  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz(6)
+  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
+  createdBy      String    @map("created_by")
+  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
+  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
+  person         Employee  @relation("AssignmentPerson", fields: [tenantId, personId], references: [tenantId, employeeId], onDelete: Restrict, onUpdate: Cascade)
+  manager        Employee? @relation("AssignmentManager", fields: [tenantId, managerId], references: [tenantId, employeeId], onDelete: Restrict, onUpdate: Cascade)
+  orgUnit        OrgUnit   @relation("OrgUnitAssignments", fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
+
+  @@index([tenantId, personId, effectiveFrom])
+  @@index([tenantId, orgUnitId])
+  @@map("assignments")
+}

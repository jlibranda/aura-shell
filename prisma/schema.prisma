generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant is the storage isolation root. Trusted request construction—not the
/// browser—selects the tenant used by future repository adapters.
model Tenant {
  id                           String                        @id @map("tenant_id")
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees                    Employee[]
  auditRecords                 AuditRecord[]
  submissionIdempotencyRecords SubmissionIdempotencyRecord[]
  outboxMessages               OutboxMessage[]
  tenantMemberships            TenantMembership[]
  sessions                     Session[]
  configurationDefinitions     ConfigurationDefinition[]
  configurationVersions        ConfigurationVersion[]
  orgUnits                     OrgUnit[]
  assignments                  Assignment[]
  locations                    Location[]
  legalEntities                LegalEntity[]
  attendanceEvents             AttendanceEvent[]
  workSchedules                WorkSchedule[]
  workScheduleVersions         WorkScheduleVersion[]

  @@map("tenants")
}

/// The stable identity of one configurable policy/settings object (Epic 7
/// Slice 7A). scopeType/scopeReference describe *where* this definition
/// applies; only TENANT is populated today since no legal-entity/location/
/// department tables exist yet to attach a real assignment to — the field
/// exists so the resolver contract doesn't have to change shape later.
model ConfigurationDefinition {
  id          String                 @id @default(uuid()) @map("definition_id")
  tenantId    String                 @map("tenant_id")
  type        String                 @map("type")
  code        String                 @map("code")
  name        String                 @map("name")
  description String?                @map("description")
  scopeType   String                 @default("TENANT") @map("scope_type")
  scopeRef    String                 @map("scope_ref")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String                 @map("created_by")
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions    ConfigurationVersion[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("configuration_definitions")
}

/// One version of a configuration's payload. Published versions are
/// immutable in application code (see ConfigurationUnitOfWork); a
/// correction always creates a new version rather than mutating this row.
/// updatedAt doubles as the optimistic-concurrency token for draft edits.
model ConfigurationVersion {
  id             String                  @id @default(uuid()) @map("version_id")
  definitionId   String                  @map("definition_id")
  tenantId       String                  @map("tenant_id")
  versionNumber  Int                     @map("version_number")
  status         String                  @map("status")
  effectiveFrom  DateTime?               @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime?               @map("effective_until") @db.Timestamptz(6)
  payload        Json                    @map("payload")
  schemaVersion  Int                     @default(1) @map("schema_version")
  changeReason   String?                 @map("change_reason")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String                  @map("created_by")
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt    DateTime?               @map("published_at") @db.Timestamptz(6)
  publishedBy    String?                 @map("published_by")
  retiredAt      DateTime?               @map("retired_at") @db.Timestamptz(6)
  definition     ConfigurationDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([definitionId, versionNumber])
  @@index([tenantId, definitionId, status])
  @@index([tenantId, definitionId, effectiveFrom])
  @@map("configuration_versions")
}

/// LegalEntity — the registered employer of record (Epic 7B.6, ADR-013).
/// A peer Organization aggregate, never an OrgUnit `kind`: every OrgUnit
/// belongs to exactly one Legal Entity (ownership, not attribute), and every
/// Assignment records the Legal Entity of the OrgUnit it places a person into.
/// `id` and `code` are stable identity — immutable and never reused. Archived,
/// never hard-deleted, matching OrgUnit/Location. Deliberately narrow scope
/// (ADR-013 §3): no tax registrations, statutory account numbers, bank
/// accounts, payroll calendars, or country payroll rules — those are
/// Payroll-domain concerns that attach later, when Payroll is built.
model LegalEntity {
  id          String       @id @default(uuid()) @map("legal_entity_id")
  tenantId    String       @map("tenant_id")
  code        String       @map("code")
  legalName   String       @map("legal_name")
  /// ISO 3166-1 alpha-2, e.g. "PH", "SG", "US".
  countryCode String       @map("country_code")
  status      String       @default("ACTIVE") @map("status")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String       @map("created_by")
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orgUnits    OrgUnit[]    @relation("LegalEntityOrgUnits")
  assignments Assignment[] @relation("LegalEntityAssignments")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("legal_entities")
}

/// OrgUnit — the single, recursive, typed organizational node (Epic 7B.1,
/// ADR-012). One aggregate differentiated by `kind`; never a table per level.
/// A strict single-parent tree: `parentId` is null for a root and otherwise
/// names one parent in the same tenant, enforced by the composite
/// (tenant_id, parent_id) -> (tenant_id, org_unit_id) foreign key. `id` and
/// `code` are stable identity — immutable and never reused. Not a versioned
/// entity: it is mutable structural master data (rename, move, archive), with
/// history captured in the immutable audit trail, not in per-row versions.
/// Every OrgUnit belongs to exactly one Legal Entity (ADR-013 §3) — ownership,
/// not an optional attribute; a parent-child relationship is only valid within
/// the same Legal Entity (enforced in OrgUnitService, not at the database,
/// since it is a cross-row invariant over the live tree).
model OrgUnit {
  id            String       @id @default(uuid()) @map("org_unit_id")
  tenantId      String       @map("tenant_id")
  legalEntityId String       @map("legal_entity_id")
  code          String       @map("code")
  name          String       @map("name")
  kind          String       @map("kind")
  parentId      String?      @map("parent_id")
  status        String       @default("ACTIVE") @map("status")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String       @map("created_by")
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  legalEntity   LegalEntity  @relation("LegalEntityOrgUnits", fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  parent        OrgUnit?     @relation("OrgUnitHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  children      OrgUnit[]    @relation("OrgUnitHierarchy")
  assignments   Assignment[] @relation("OrgUnitAssignments")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, status])
  @@index([tenantId, legalEntityId])
  @@map("org_units")
}

/// Assignment — the authoritative, effective-dated placement of a person into
/// the organization (ADR-012 §5, §7). This is the source of truth for a
/// person's org unit and primary manager over time; the Employee.department/
/// team/manager/workLocation columns are legacy. A placement is never edited
/// in place: a transfer ends the current window and opens a new one, so
/// historical placement is always resolvable. Composite tenant-scoped foreign
/// keys make a cross-tenant person/manager/org-unit reference impossible at the
/// database. "At most one PRIMARY in force per person at any instant" is
/// enforced by a GIST exclusion constraint installed in the migration.
model Assignment {
  id             String      @id @default(uuid()) @map("assignment_id")
  tenantId       String      @map("tenant_id")
  personId       String      @map("person_id")
  /// The employer of record this placement belongs to (ADR-013 §3). Always
  /// equal to orgUnit.legalEntityId at the effective date — Assignment
  /// records the OrgUnit's Legal Entity, it does not carry an independent,
  /// separately-editable entity. Ordinary transfer/manager/location changes
  /// preserve this value; only Hire sets it in this slice.
  legalEntityId  String      @map("legal_entity_id")
  orgUnitId      String      @map("org_unit_id")
  managerId      String?     @map("manager_id")
  /// The assigned work Location, when the placement has one (nullable —
  /// most existing assignments predate this column, and Location assignment
  /// is phased in per employee, not backfilled in bulk). Location is
  /// orthogonal to the OrgUnit tree (ADR-012 §5): this is a plain reference,
  /// never a hierarchy relationship.
  locationId     String?     @map("location_id")
  isPrimary      Boolean     @default(true) @map("is_primary")
  effectiveFrom  DateTime    @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime?   @map("effective_until") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String      @map("created_by")
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person         Employee    @relation("AssignmentPerson", fields: [tenantId, personId], references: [tenantId, employeeId], onDelete: Restrict, onUpdate: Cascade)
  manager        Employee?   @relation("AssignmentManager", fields: [tenantId, managerId], references: [tenantId, employeeId], onDelete: Restrict, onUpdate: Cascade)
  legalEntity    LegalEntity @relation("LegalEntityAssignments", fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  orgUnit        OrgUnit     @relation("OrgUnitAssignments", fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  location       Location?   @relation("AssignmentLocation", fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, personId, effectiveFrom])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, locationId])
  @@index([tenantId, legalEntityId])
  @@map("assignments")
}

/// Location — a physical or recognized work site (ADR-012 §5). A dimension
/// orthogonal to the OrgUnit tree, not a node within it: never an OrgUnit
/// `kind`, never owned by an OrgUnit. `id` and `code` are stable identity —
/// immutable and never reused. A rename changes only the display name.
/// Locations are archived, never hard-deleted; history lives in the audit
/// trail, not in per-row versions. Address is a value object flattened onto
/// this table (no independent lifecycle, per ADR-012 §5/§8).
model Location {
  id           String    @id @default(uuid()) @map("location_id")
  tenantId     String    @map("tenant_id")
  code         String    @map("code")
  name         String    @map("name")
  addressLine1 String    @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String    @map("city")
  region       String?   @map("region")
  postalCode   String?   @map("postal_code")
  countryCode  String    @map("country_code")
  timezone     String    @map("timezone")
  status       String    @default("ACTIVE") @map("status")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments  Assignment[] @relation("AssignmentLocation")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("locations")
}

/// The platform login identity (Epic 6 Slice 6M0.1). Deliberately separate
/// from Employee: Employee is HR record data, not authentication data, and
/// a User is not guaranteed to correspond to an Employee row.
model User {
  id                String             @id @default(uuid()) @map("user_id")
  email             String             @unique @map("email")
  passwordHash      String             @map("password_hash")
  passwordSalt      String             @map("password_salt")
  status            String             @default("active") @map("status")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantMemberships TenantMembership[]
  sessions          Session[]

  @@map("users")
}

/// Which tenant a User may access, and with which roles. Roles are the same
/// flat PlatformRole[] shape TrustedRequestContext already carries — no
/// separate RoleAssignment table, since roles have no independent lifecycle
/// of their own here (see Slice 6M0.1 architecture analysis).
model TenantMembership {
  id        String   @id @default(uuid()) @map("membership_id")
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  roles     String[] @map("roles")
  status    String   @default("active") @map("status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

/// A server-verified session. The browser cookie carries only the opaque
/// token; tokenHash (not the token) is what's stored, so a database read
/// alone can never produce a usable session. tenantId is the tenant this
/// session was authenticated into — resolved server-side at login from the
/// user's memberships, never taken from the browser.
model Session {
  id        String   @id @default(uuid()) @map("session_id")
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Transactional domain-event delivery record. Payloads are safe event
/// projections; workers never read Employee aggregates through this model.
model OutboxMessage {
  messageId           String    @id @map("message_id")
  eventId             String    @unique @map("event_id")
  tenantId            String    @map("tenant_id")
  eventName           String    @map("event_name")
  aggregateType       String    @map("aggregate_type")
  aggregateId         String    @map("aggregate_id")
  correlationId       String    @map("correlation_id")
  occurredAt          DateTime  @map("occurred_at") @db.Timestamptz(6)
  payload             Json
  state               String
  attempts            Int       @default(0)
  availableAt         DateTime  @map("available_at") @db.Timestamptz(6)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(6)
  leaseOwner          String?   @map("lease_owner")
  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(6)
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode       String?   @map("last_error_code")
  lastError           String?   @map("last_error")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([state, availableAt])
  @@index([state, leaseExpiresAt])
  @@index([tenantId, occurredAt])
  @@map("outbox_messages")
}

/// Durable replay protection for internal command submission. It records only
/// a request hash and a sanitized result; no employee personal data is stored.
model SubmissionIdempotencyRecord {
  tenantId       String   @map("tenant_id")
  idempotencyKey String   @map("idempotency_key")
  commandType    String   @map("command_type")
  requestHash    String   @map("request_hash")
  state          String
  result         Json?    @map("result_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tenantId, idempotencyKey])
  @@map("submission_idempotency_records")
}

/// This is the durable representation of the existing authoritative employee
/// aggregate. Government identifiers, payroll, compensation, tax, and banking
/// data are deliberately not part of this model.
model Employee {
  tenantId              String       @map("tenant_id")
  employeeId            String       @map("employee_id")
  employeeNumber        String       @map("employee_number")
  displayName           String       @map("display_name")
  firstName             String       @map("first_name")
  middleName            String?      @map("middle_name")
  lastName              String       @map("last_name")
  preferredName         String?      @map("preferred_name")
  dateOfBirth           DateTime     @map("date_of_birth") @db.Date
  gender                String
  maritalStatus         String       @map("marital_status")
  nationality           String
  workEmail             String       @map("work_email")
  personalEmail         String?      @map("personal_email")
  mobileNumber          String       @map("mobile_number")
  homeAddress           String       @map("home_address")
  /// LEGACY placement fields (ADR-012 §7). Superseded by the Assignment
  /// aggregate, which is the authoritative, effective-dated source of a
  /// person's org unit and manager. These columns are retained (not removed)
  /// for backward compatibility and are no longer the source of truth for
  /// placement; new placement reads/writes go through Assignment.
  departmentId          String       @map("department_id")
  teamId                String?      @map("team_id")
  position              String
  managerId             String?      @map("manager_id")
  employmentType        String       @map("employment_type")
  employmentStatus      String?      @map("employment_status")
  hireDate              DateTime     @map("hire_date") @db.Date
  /// Nullable: new hires no longer write here (Assignment.locationId is
  /// authoritative from day one) — this stays populated only for employees
  /// hired before Location assignment existed.
  workLocation          String?      @map("work_location")
  emergencyContactName  String?      @map("emergency_contact_name")
  emergencyRelationship String?      @map("emergency_relationship")
  emergencyMobileNumber String?      @map("emergency_mobile_number")
  emergencyEmail        String?      @map("emergency_email")
  emergencyAddress      String?      @map("emergency_address")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignmentsAsPerson   Assignment[] @relation("AssignmentPerson")
  assignmentsAsManager  Assignment[] @relation("AssignmentManager")
  attendanceEvents      AttendanceEvent[] @relation("AttendanceEventPerson")

  @@id([tenantId, employeeId])
  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, workEmail])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, departmentId])
  @@map("employees")
}

/// AttendanceEvent — the immutable, atomic fact that a person's clock-in/out
/// channel registered a punch at a specific instant (ADR-014 §4.3,
/// Timekeeping Slice 1). Create-only: the migration installs a PostgreSQL
/// trigger that rejects UPDATE and DELETE operations on this table, the same
/// pattern already used for audit_records and configuration_versions.
/// Corrections belong to a future AttendanceAdjustment against the computed
/// AttendanceDay — never a mutation of this row.
model AttendanceEvent {
  id              String    @id @default(uuid()) @map("attendance_event_id")
  tenantId        String    @map("tenant_id")
  personId        String    @map("person_id")
  /// The device/channel-reported instant the punch occurred, UTC.
  occurredAtUtc   DateTime  @map("occurred_at_utc") @db.Timestamptz(6)
  /// When AURA received this event — distinct from occurredAtUtc
  /// (channel-reported) and createdAt (persistence time). Never compared
  /// against occurredAtUtc to reject an event: clock skew and delayed/
  /// offline sync are forensic/anomaly concerns, not grounds to refuse a
  /// genuinely received fact (ADR-014 §15).
  receivedAtUtc   DateTime  @map("received_at_utc") @db.Timestamptz(6)
  /// Stable channel category (ADR-014 §4.3, §8) — never vendor-specific;
  /// vendor/device identity belongs to sourceRef so a new vendor never
  /// requires a schema migration.
  source          String    @map("source")
  /// Device id / import batch id / API caller — free-text, channel-specific.
  sourceRef       String?   @map("source_ref")
  /// What the source channel itself reported, if known — evidentiary only,
  /// never authoritative. AttendanceDay remains solely responsible for
  /// interpreting event chronology (ADR-014 §4.4, §9).
  eventType       String?   @map("event_type")
  idempotencyKey  String    @map("idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person          Employee  @relation("AttendanceEventPerson", fields: [tenantId, personId], references: [tenantId, employeeId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, personId, occurredAtUtc])
  @@map("attendance_events")
}

/// WorkSchedule — a reusable, tenant-scoped schedule template (ADR-014
/// §4.1, Timekeeping Slice 3). Stable identity/label only; every field that
/// affects what the schedule computes to lives on WorkScheduleVersion.
/// `code` is permanent business identity, never changed, never reused.
model WorkSchedule {
  id          String                @id @default(uuid()) @map("work_schedule_id")
  tenantId    String                @map("tenant_id")
  code        String                @map("code")
  name        String                @map("name")
  description String?               @map("description")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String                @map("created_by")
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions    WorkScheduleVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("work_schedules")
}

/// One versioned content snapshot of a WorkSchedule (ADR-014 §4.1; Slice 3
/// Decisions 1, 8, 9). DRAFT content may be replaced in full before
/// activation; ACTIVE/RETIRED content is never mutated — a change
/// always creates a new DRAFT version instead. At most one ACTIVE version
/// per work_schedule_id is enforced by a partial unique index (see
/// migration), not application code alone. `canonicalHash` is for
/// duplicate-content detection only — never business identity.
model WorkScheduleVersion {
  id                      String       @id @default(uuid()) @map("work_schedule_version_id")
  tenantId                String       @map("tenant_id")
  workScheduleId          String       @map("work_schedule_id")
  versionNumber           Int          @map("version_number")
  status                  String       @map("status")
  scheduleType            String       @map("schedule_type")
  timezoneResolutionMode  String       @map("timezone_resolution_mode")
  /// Required iff timezoneResolutionMode = FIXED; absent iff LOCATION.
  timezone                String?      @map("timezone")
  weeklyPattern           Json         @map("weekly_pattern")
  canonicalHash           String       @map("canonical_hash")
  changeReason            String?      @map("change_reason")
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy               String       @map("created_by")
  activatedAt             DateTime?    @map("activated_at") @db.Timestamptz(6)
  retiredAt               DateTime?    @map("retired_at") @db.Timestamptz(6)
  tenant                  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workSchedule            WorkSchedule @relation(fields: [tenantId, workScheduleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([workScheduleId, versionNumber])
  @@index([tenantId, workScheduleId, status])
  @@map("work_schedule_versions")
}

/// Append-only command outcome evidence. The migration installs a PostgreSQL
/// trigger that rejects UPDATE and DELETE operations on this table.
model AuditRecord {
  auditId       String   @id @map("audit_id")
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  tenantId      String   @map("tenant_id")
  actorUserId   String   @map("actor_user_id")
  requestId     String   @map("request_id")
  correlationId String   @map("correlation_id")
  transactionId String   @map("transaction_id")
  commandName   String   @map("command_name")
  eventName     String   @map("event_name")
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  result        String
  metadata      Json
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([correlationId])
  @@map("audit_records")
}
